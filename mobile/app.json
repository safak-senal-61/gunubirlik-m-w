{
  "expo": {
    "name": "Günübirlik",
    "slug": "gunubirlik",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gunubirlik",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gunubirlik.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakınındaki günlük işleri ve ilan konumlarını göstermek için konumunu kullanıyoruz.",
        "NSCameraUsageDescription": "Profil fotoğrafı çekmek için kamera erişimi gerekiyor.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.gunubirlik.app",
      "versionCode": 14,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "smallIconAccentColor": "#4f46e5"
        }
      ],
      "expo-location",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafını seçmek için galerine erişim gerekiyor.",
          "cameraPermission": "Profil fotoğrafı çekmek için kamera erişimi gerekiyor."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "İşe başlama/bitiş ve QR ile ödeme kodlarını okutmak için kamera erişimi gerekiyor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "onesignal": {
        "appId": "6bddc78e-79e7-4701-9e46-6fca772e402a"
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.gunubirlik.app.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.gunubirlik.app.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "7caca633-ad71-45c8-9c19-86e76215da99"
      }
    },
    "owner": "safak61s-team"
  }
}
