{
  "expo": {
    "name": "Günübirlik",
    "slug": "gunubirlik",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gunubirlik",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gunubirlik.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakınındaki günlük işleri ve ilan konumlarını göstermek için konumunu kullanıyoruz.",
        "NSCameraUsageDescription": "Profil fotoğrafı çekmek için kamera erişimi gerekiyor.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.gunubirlik.app",
      "versionCode": 11,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      }
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "smallIconAccentColor": "#4f46e5"
        }
      ],
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafını seçmek için galerine erişim gerekiyor.",
          "cameraPermission": "Profil fotoğrafı çekmek için kamera erişimi gerekiyor."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "İşe başlama/bitiş ve QR ile ödeme kodlarını okutmak için kamera erişimi gerekiyor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "8f2eb971-94c6-4b23-8ecb-2314a43cbc9d"
      },
      "onesignal": {
        "appId": "6bddc78e-79e7-4701-9e46-6fca772e402a"
      }
    },
    "owner": "manahos"
  }
}
